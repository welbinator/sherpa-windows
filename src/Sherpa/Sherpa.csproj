<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/sherpa.ico</ApplicationIcon>
    <RootNamespace>Sherpa</RootNamespace>
    <AssemblyName>Sherpa</AssemblyName>
    <Version>0.2.11</Version>
    <AssemblyVersion>0.2.11.13</AssemblyVersion>
    <FileVersion>0.2.11.13</FileVersion>
    <InformationalVersion>0.2.11+build.13</InformationalVersion>
    <Product>Sherpa</Product>
    <Company>Sherpa</Company>
    <Authors>welbinator</Authors>
    <Description>Windows port of Sherpa — local Statamic/Laravel site manager (Jack-crafted DX).</Description>
    <!-- Mostly-single-file: app is one exe, but WebView2 Core+Loader MUST sit beside it.
         Their SDK does Path.Combine(Assembly.Location, …) which is null inside a
         true single-file bundle → black preview / ArgumentNullException path1. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- Real browser preview (WebView2 on Windows). Free FOSS stack — not Avalonia Accelerate. -->
    <PackageReference Include="WebView.Avalonia" Version="11.0.0.1" />
    <PackageReference Include="WebView.Avalonia.Desktop" Version="11.0.0.1" />
  </ItemGroup>

  <!-- Leave WebView2 bits outside the single-file bundle so the official loader can
       resolve WebView2Loader.dll next to Microsoft.Web.WebView2.Core.dll. -->
  <Target Name="ExcludeWebView2FromSingleFile"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             Condition="'%(Filename)%(Extension)' == 'Microsoft.Web.WebView2.Core.dll'
                                     or '%(Filename)%(Extension)' == 'WebView2Loader.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
