<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sherpa.ViewModels"
        xmlns:models="using:Sherpa.Models"
        x:Class="Sherpa.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sherpa"
        Width="1240" Height="780"
        MinWidth="1000" MinHeight="640"
        Background="#0B0D12">

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="250,*">

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="#0F1218" BorderBrush="#1E2430" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,18,16,8" Spacing="4">
            <TextBlock Text="Sherpa" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="Sites · packages · deploys" Foreground="#9AA3B2" FontSize="12" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="12,8" Spacing="6">
            <Button Content="New Site" Command="{Binding OpenNewSiteWizardCommand}" HorizontalAlignment="Stretch" />
            <Button Content="Import Existing" Command="{Binding OpenImportSheetCommand}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <DockPanel Margin="0,8,0,0">
            <ListBox DockPanel.Dock="Top" Margin="4,0" SelectedIndex="{Binding SelectedNavIndex}">
              <ListBoxItem Content="Sites" />
              <ListBoxItem Content="Hosts" />
              <ListBoxItem Content="Settings" />
            </ListBox>

            <ListBox Margin="8,12,8,8"
                     ItemsSource="{Binding Sites}"
                     SelectedItem="{Binding SelectedSite}"
                     IsVisible="{Binding IsSitesNav}"
                     Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Site">
                  <StackPanel Spacing="2" Margin="4,6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Kind}" Foreground="#9AA3B2" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- Main -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="20,14" BorderBrush="#1E2430" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock FontSize="22" FontWeight="SemiBold"
                         Text="{Binding SelectedSite.Name, FallbackValue='Sherpa'}" />
              <TextBlock Foreground="#9AA3B2" FontSize="13" Text="{Binding StatusLine}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding BusyLabel}" Foreground="#9AA3B2" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
              <Button Content="Copy errors" Command="{Binding CopyErrorsCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <Panel Grid.Row="1">
          <!-- SITES -->
          <Grid IsVisible="{Binding IsSitesNav}" ColumnDefinitions="*,340" Margin="16">
            <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1"
                    IsVisible="{Binding SelectedSite, Converter={x:Static ObjectConverters.IsNull}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding EmptyBody}" Foreground="#9AA3B2" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Create your first site" Command="{Binding OpenNewSiteWizardCommand}" />
                  <Button Content="Import Existing" Command="{Binding OpenImportSheetCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <DockPanel IsVisible="{Binding SelectedSite, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TabControl SelectedIndex="{Binding SelectedDetailTab}">
                <TabItem Header="Overview">
                  <ScrollViewer Padding="4,12">
                    <StackPanel Spacing="12" MaxWidth="760">
                      <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Path" FontWeight="SemiBold" />
                          <TextBox Text="{Binding SelectedSite.Path}" IsReadOnly="True" />
                          <TextBlock Text="URL preview" FontWeight="SemiBold" Margin="0,6,0,0" />
                          <TextBox Text="{Binding SelectedSite.Url}" />
                          <TextBlock Foreground="#9AA3B2" Text="{Binding SelectedSite.Kind}" />
                          <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,8,8" Content="Open folder" Command="{Binding OpenSiteFolderCommand}" />
                            <Button Margin="0,0,8,8" Content="Open site" Command="{Binding OpenSiteUrlCommand}" />
                            <Button Margin="0,0,8,8" Content="Link to Herd" Command="{Binding LinkHerdCommand}" />
                            <Button Margin="0,0,8,8" Content="Secure with HTTPS (Herd)" Command="{Binding SecureHerdCommand}" />
                            <Button Margin="0,0,8,8" Content="Create User" Command="{Binding OpenCreateUserSheetCommand}" />
                            <Button Margin="0,0,8,8" Content="Commands" Command="{Binding OpenCommandsSheetCommand}" />
                            <Button Margin="0,0,8,8" Content="Remove from Sherpa" Command="{Binding ConfirmRemoveCommand}" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Quick actions" FontWeight="SemiBold" />
                          <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap"
                                     Text="Clear Cache flushes Laravel caches. Clear Stache rebuilds Statamic's content index from files. Clear Glide Cache deletes generated image transforms so they regenerate on the next request." />
                          <WrapPanel>
                            <Button Margin="0,0,8,8" Content="Clear Cache" Command="{Binding ClearCacheCommand}" />
                            <Button Margin="0,0,8,8" Content="Clear Stache" Command="{Binding ClearStacheCommand}" />
                            <Button Margin="0,0,8,8" Content="Warm Stache" Command="{Binding WarmStacheCommand}" />
                            <Button Margin="0,0,8,8" Content="Clear Glide Cache" Command="{Binding ClearGlideCommand}" />
                            <Button Margin="0,0,8,8" Content="Composer install" Command="{Binding ComposerInstallCommand}" />
                            <Button Margin="0,0,8,8" Content="Update Packages" Command="{Binding ComposerUpdateCommand}" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Git">
                  <ScrollViewer Padding="4,12">
                    <StackPanel Spacing="12" MaxWidth="760">
                      <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap"
                                 Text="Every change to your site can be tracked, so you can always roll back. Save changes commits the checked files; nothing is sent to GitHub until you Push or Sync." />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh" Command="{Binding RefreshGitCommand}" />
                        <Button Content="Initialize Git" Command="{Binding GitInitCommand}" />
                        <Button Content="Save changes" Command="{Binding SaveChangesCommand}" />
                        <Button Content="Pull" Command="{Binding PullCommand}" />
                        <Button Content="Push" Command="{Binding PushCommand}" />
                        <Button Content="Sync" Command="{Binding SyncCommand}" />
                      </StackPanel>
                      <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding GitBranchLine}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="Commit message" FontWeight="SemiBold" Margin="0,8,0,0" />
                          <TextBox Text="{Binding GitCommitMessage}" />
                          <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,8,0">
                              <TextBlock Text="Git name" FontWeight="SemiBold" />
                              <TextBox Text="{Binding GitUserName}" Watermark="Required once" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="Git email" FontWeight="SemiBold" />
                              <TextBox Text="{Binding GitUserEmail}" Watermark="Required once" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Foreground="#9AA3B2" Text="Git needs your name and email before it can save changes." />
                        </StackPanel>
                      </Border>
                      <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Changed files" FontWeight="SemiBold" />
                          <ItemsControl ItemsSource="{Binding GitFiles}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:GitFileItem">
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4">
                                  <CheckBox IsChecked="{Binding Selected}" />
                                  <TextBlock Grid.Column="1" Text="{Binding Status}" Width="36" Margin="8,0" FontFamily="Consolas" VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="2" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Back up to GitHub" Command="{Binding BackupToGitHubCommand}" />
                      </StackPanel>
                      <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Recent commits" FontWeight="SemiBold" />
                          <TextBox Text="{Binding GitLogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" MinHeight="120" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Packages">
                  <DockPanel Margin="4,12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                      <Button Content="Composer require…" Command="{Binding OpenComposerSheetCommand}" />
                      <Button Content="Update Packages" Command="{Binding ComposerUpdateCommand}" />
                      <Button Content="Composer install" Command="{Binding ComposerInstallCommand}" />
                      <Button Content="Refresh" Command="{Binding RefreshGitCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Packages}" Background="Transparent">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackageRow">
                          <Border Background="#161A22" CornerRadius="10" Padding="12" BorderBrush="#2A3140" BorderThickness="1" Margin="0,0,0,8">
                            <StackPanel Spacing="2">
                              <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                              <TextBlock Foreground="#9AA3B2" Text="{Binding Version}" />
                              <TextBlock Foreground="#9AA3B2" Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </TabItem>

                <TabItem Header="Commands">
                  <ScrollViewer Padding="4,12">
                    <StackPanel Spacing="12" MaxWidth="720">
                      <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap"
                                 Text="Runs real please / artisan commands in this site's folder. PHP comes from Herd or the path you set under Settings." />
                      <WrapPanel>
                        <Button Margin="0,0,8,8" Content="Clear Cache" Command="{Binding ClearCacheCommand}" />
                        <Button Margin="0,0,8,8" Content="Clear Stache" Command="{Binding ClearStacheCommand}" />
                        <Button Margin="0,0,8,8" Content="Warm Stache" Command="{Binding WarmStacheCommand}" />
                        <Button Margin="0,0,8,8" Content="Clear Glide Cache" Command="{Binding ClearGlideCommand}" />
                        <Button Margin="0,0,8,8" Content="Create User" Command="{Binding OpenCreateUserSheetCommand}" />
                        <Button Margin="0,0,8,8" Content="Run custom…" Command="{Binding OpenCommandsSheetCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <TabItem Header="Deploy">
                  <ScrollViewer Padding="4,12">
                    <StackPanel Spacing="12" MaxWidth="720">
                      <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Deploy" FontWeight="SemiBold" />
                          <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap"
                                     Text="Laravel Cloud for dynamic Statamic sites. Netlify or Cloudflare Pages for static SSG deploys. Connect hosts first — tokens stay in the secret store." />
                          <Button Content="Check deploy prerequisites" Command="{Binding DeployPrerequisiteCheckCommand}" HorizontalAlignment="Left" />
                          <Button Content="Back up to GitHub first" Command="{Binding BackupToGitHubCommand}" HorizontalAlignment="Left" />
                          <Button Content="Connect a New Host" Command="{Binding OpenConnectHostSheetCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                      </Border>
                      <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                        <StackPanel Spacing="6">
                          <TextBlock Text="Deployment history" FontWeight="SemiBold" />
                          <TextBlock Foreground="#9AA3B2" Text="No deploys yet." />
                          <ItemsControl ItemsSource="{Binding Deployments}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:DeploymentRecord">
                                <TextBlock Margin="0,4" Text="{Binding Summary}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>
              </TabControl>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="12,0,0,0" IsVisible="{Binding SelectedSite, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock DockPanel.Dock="Top" Text="Activity" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Advice}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ConflictAdvice">
                    <Border Background="#1A1520" CornerRadius="10" Padding="12" BorderBrush="#5B3A4A" BorderThickness="1" Margin="0,0,0,8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Detail}" Foreground="#9AA3B2" TextWrapping="Wrap" FontSize="12" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
            </DockPanel>
          </Grid>

          <!-- HOSTS -->
          <ScrollViewer IsVisible="{Binding IsHostsNav}" Padding="24">
            <StackPanel Spacing="16" MaxWidth="680">
              <TextBlock Text="Hosts" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap"
                         Text="Tokens stay in the Windows secret store. Sherpa never writes them into your sites." />
              <Button Content="Connect a New Host" Command="{Binding OpenConnectHostSheetCommand}" HorizontalAlignment="Left" />
              <ItemsControl ItemsSource="{Binding HostAccounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:HostAccount">
                    <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1" Margin="0,0,0,8">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        <TextBlock Foreground="#9AA3B2" Text="{Binding Provider}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="Dynamic hosting" FontWeight="SemiBold" />
                  <TextBlock Foreground="#9AA3B2" Text="Laravel Forge · Laravel Cloud" />
                  <TextBlock Text="Static hosting" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Foreground="#9AA3B2" Text="Cloudflare Pages · Netlify" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- SETTINGS -->
          <ScrollViewer IsVisible="{Binding IsSettingsNav}" Padding="24">
            <StackPanel Spacing="16" MaxWidth="680">
              <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
              <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="Default sites folder" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding DefaultSitesFolder}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseSitesFolderCommand}" />
                  </Grid>
                  <CheckBox Content="Prefer Herd for new sites" IsChecked="{Binding PreferHerdForNewSites}" />
                  <CheckBox Content="Secure new Herd sites with HTTPS" IsChecked="{Binding SecureNewHerdSites}" />
                  <TextBlock Text="Git name" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBox Text="{Binding GitUserName}" />
                  <TextBlock Text="Git email" FontWeight="SemiBold" />
                  <TextBox Text="{Binding GitUserEmail}" />
                  <TextBlock Text="PHP path (optional)" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBox Text="{Binding PreferredPhp}" Watermark="Auto-detect Herd / PATH" />
                  <TextBlock Text="Composer path (optional)" FontWeight="SemiBold" />
                  <TextBox Text="{Binding PreferredComposer}" />
                  <TextBlock Text="Git path (optional)" FontWeight="SemiBold" />
                  <TextBox Text="{Binding PreferredGit}" />
                  <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="GitHub personal access token" FontWeight="SemiBold" />
                  <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap"
                             Text="Create a classic token at GitHub → Settings → Developer settings. Used for private starter kits, package repos, and Back up to GitHub." />
                  <TextBox Watermark="ghp_…" PasswordChar="•" Text="{Binding GitHubTokenInput}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save GitHub token" Command="{Binding SaveGitHubTokenCommand}" />
                    <Button Content="Remove" Command="{Binding ClearGitHubTokenCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding GitHubStatus}" Foreground="#9AA3B2" TextWrapping="Wrap" />
                  <TextBlock Text="Packagist / Composer auth token" FontWeight="SemiBold" Margin="0,12,0,0" />
                  <TextBox Watermark="optional" PasswordChar="•" Text="{Binding PackagistTokenInput}" />
                  <Button Content="Save Packagist token" Command="{Binding SavePackagistTokenCommand}" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding PackagistStatus}" Foreground="#9AA3B2" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="Detected runtimes" FontWeight="SemiBold" />
                  <TextBox Text="{Binding RuntimeStatus}" IsReadOnly="True" AcceptsReturn="True"
                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" MinHeight="110" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="#0F1218" BorderBrush="#1E2430" BorderThickness="0,1,0,0" Padding="12,8">
      <TextBlock Foreground="#9AA3B2" FontSize="12"
                 Text="Sherpa for Windows · 0.2.0 (build 2) · Tokens stay in the Windows secret store" />
    </Border>

    <!-- Toast -->
    <Border IsVisible="{Binding ShowToast}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,20,48" Background="#161A22" CornerRadius="10" Padding="14" BorderBrush="#2A3140" BorderThickness="1" ZIndex="20" MaxWidth="320">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding ToastTitle}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ToastBody}" Foreground="#9AA3B2" TextWrapping="Wrap" />
        <Button Content="Dismiss" Command="{Binding DismissToastCommand}" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>

    <!-- NEW SITE WIZARD (Mac-shaped) -->
    <Grid IsVisible="{Binding ShowNewSiteWizard}" Background="#99000000" ZIndex="30">
      <Border Background="#161A22" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
              CornerRadius="12" Padding="22" BorderBrush="#2A3140" BorderThickness="1">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock Text="New Site" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap" Text="Start blank or pick a Marketplace starter kit." />

            <TextBlock Text="Starting point" FontWeight="SemiBold" Margin="0,4,0,0" />
            <RadioButton Content="Blank site" GroupName="Start" IsChecked="{Binding StartBlank}" />
            <RadioButton Content="Fresh Statamic, no starter kit" GroupName="Start" IsChecked="{Binding StartFreshStatamic}" />
            <TextBlock Foreground="#9AA3B2" FontSize="12" Text="Marketplace starter kits: next build (API + license panel)." />

            <TextBlock Text="Site name" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox Text="{Binding NewSiteName}" Watermark="my-site" />

            <TextBlock Text="Folder" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding NewSiteFolder}" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseNewSiteFolderCommand}" />
            </Grid>

            <TextBlock Text="URL preview" FontWeight="SemiBold" />
            <TextBox Text="{Binding NewSiteUrlPreview}" IsReadOnly="True" />

            <TextBlock Text="Will create" FontWeight="SemiBold" />
            <TextBox Text="{Binding NewSiteWillCreate}" IsReadOnly="True" />

            <CheckBox Content="Park in Herd and open as site.test" IsChecked="{Binding NewSiteParkInHerd}" />
            <CheckBox Content="Secure with HTTPS (Herd)" IsChecked="{Binding NewSiteSecureHttps}" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
              <Button Content="Cancel" Command="{Binding CloseNewSiteWizardCommand}" />
              <Button Content="Create Site" Command="{Binding CreateSiteCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Import -->
    <Grid IsVisible="{Binding ShowImportSheet}" Background="#99000000" ZIndex="30">
      <Border Background="#161A22" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="20" BorderBrush="#2A3140" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Import Existing Site" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap" Text="Point Sherpa at a folder that already has Statamic installed." />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding ImportPath}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseImportFolderCommand}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CloseImportSheetCommand}" />
            <Button Content="Import" Command="{Binding ImportSiteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Composer require -->
    <Grid IsVisible="{Binding ShowComposerSheet}" Background="#99000000" ZIndex="30">
      <Border Background="#161A22" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="20" BorderBrush="#2A3140" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Composer require" FontSize="22" FontWeight="SemiBold" />
          <TextBox Watermark="vendor/package" Text="{Binding RequirePackage}" />
          <TextBox Watermark="version (optional)" Text="{Binding RequireVersion}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CloseComposerSheetCommand}" />
            <Button Content="Require" Command="{Binding ComposerRequireCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Create user -->
    <Grid IsVisible="{Binding ShowCreateUserSheet}" Background="#99000000" ZIndex="30">
      <Border Background="#161A22" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="20" BorderBrush="#2A3140" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Create User" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Foreground="#9AA3B2" Text="Creates a user via please make:user." />
          <TextBox Watermark="email" Text="{Binding CreateUserEmail}" />
          <TextBox Watermark="password" PasswordChar="•" Text="{Binding CreateUserPassword}" />
          <CheckBox Content="Create a super user" IsChecked="{Binding CreateUserSuper}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CloseCreateUserSheetCommand}" />
            <Button Content="Create" Command="{Binding CreateUserCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Commands -->
    <Grid IsVisible="{Binding ShowCommandsSheet}" Background="#99000000" ZIndex="30">
      <Border Background="#161A22" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="20" BorderBrush="#2A3140" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Commands" FontSize="22" FontWeight="SemiBold" />
          <TextBox Watermark="please stache:clear   or   artisan migrate" Text="{Binding CustomCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CloseCommandsSheetCommand}" />
            <Button Content="Run" Command="{Binding RunCustomCommandCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Connect host -->
    <Grid IsVisible="{Binding ShowConnectHostSheet}" Background="#99000000" ZIndex="30">
      <Border Background="#161A22" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="20" BorderBrush="#2A3140" BorderThickness="1">
        <StackPanel Spacing="10">
          <TextBlock Text="Connect a New Host" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Foreground="#9AA3B2" Text="Pick a provider, paste the API token. Token stays in the secret store." TextWrapping="Wrap" />
          <ComboBox SelectedIndex="{Binding ConnectHostKind}">
            <ComboBoxItem Content="(choose)" />
            <ComboBoxItem Content="Laravel Forge" />
            <ComboBoxItem Content="Laravel Cloud" />
            <ComboBoxItem Content="Cloudflare Pages" />
            <ComboBoxItem Content="Netlify" />
          </ComboBox>
          <TextBox Watermark="Label (optional)" Text="{Binding HostLabelInput}" />
          <TextBox Watermark="API token" PasswordChar="•" Text="{Binding HostTokenInput}" />
          <TextBox Watermark="Cloudflare Account ID (if Pages)" Text="{Binding HostExtraInput}" />
          <TextBlock Text="{Binding ConnectHostStatus}" Foreground="#9AA3B2" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CloseConnectHostSheetCommand}" />
            <Button Content="Connect" Command="{Binding ConnectHostCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Delete confirm -->
    <Grid IsVisible="{Binding ShowDeleteConfirm}" Background="#99000000" ZIndex="30">
      <Border Background="#161A22" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="20" BorderBrush="#2A3140" BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="Delete Site" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap"
                     Text="Remove keeps the folder on disk. Delete site files removes the project folder from disk." />
          <CheckBox Content="Delete site files too" IsChecked="{Binding DeleteSiteFilesToo}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
            <Button Content="Remove" Command="{Binding PerformDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
