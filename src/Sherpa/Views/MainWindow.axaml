<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sherpa.ViewModels"
        xmlns:models="using:Sherpa.Models"
        xmlns:wv="clr-namespace:AvaloniaWebView;assembly=Avalonia.WebView"
        x:Class="Sherpa.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sherpa"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="680"
        Background="{StaticResource BgAppBrush}">

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="220,*">

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12" Spacing="2">
            <TextBlock Text="Sherpa" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Web" Classes="dim" Margin="0,10,0,0" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="12,10" Spacing="8">
            <Button Classes="primary" Content="New Site" Command="{Binding OpenNewSiteWizardCommand}" HorizontalAlignment="Stretch" />
            <Button Content="Import Existing" Command="{Binding OpenImportSheetCommand}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <DockPanel Margin="0,4,0,0">
            <ListBox Classes="nav" DockPanel.Dock="Top" SelectedIndex="{Binding SelectedNavIndex}">
              <ListBoxItem Content="Sites" />
              <ListBoxItem Content="Hosts" />
              <ListBoxItem Content="Settings" />
            </ListBox>

            <ListBox Classes="sites"
                     Margin="0,10,0,8"
                     ItemsSource="{Binding Sites}"
                     SelectedItem="{Binding SelectedSite}"
                     IsVisible="{Binding IsSitesNav}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Site">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding Kind}" Classes="dim" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>

      <!-- Main -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <!-- Top chrome: path + Mac-style icon toolbar (only when a site is selected on Sites) -->
        <Border Grid.Row="0" Padding="14,10" BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel VerticalAlignment="Center" IsVisible="{Binding SelectedSite, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock FontSize="12" Classes="dim" Text="Sites" />
              <TextBlock FontSize="12" Classes="muted" Text="{Binding SelectedSite.Path}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" IsVisible="{Binding SelectedSite, Converter={x:Static ObjectConverters.IsNull}}">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Sherpa" />
              <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding !IsInstallingSite}" />
            </StackPanel>

            <!-- Icon toolbar — monochrome outline glyphs in a Mac-style capsule (SF Symbol energy) -->
            <Border Grid.Column="1" Classes="icon-toolbar"
                    IsVisible="{Binding SelectedSite, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Orientation="Horizontal" Spacing="0">
                <!-- 1 trash -->
                <Button Classes="icon" ToolTip.Tip="Remove site" Command="{Binding ConfirmRemoveCommand}">
                  <Path Classes="icon-glyph"
                        Data="M3 6.5h18 M8.5 6.5V5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5 M19 6.5l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2l-1-14 M10 11v7 M14 11v7" />
                </Button>
                <!-- 2 open in browser — arrow.up.right.circle -->
                <Button Classes="icon" ToolTip.Tip="Open in browser" Command="{Binding OpenSiteUrlCommand}">
                  <Path Classes="icon-glyph"
                        Data="M12 3.5 A8.5 8.5 0 1 0 12 20.5 A8.5 8.5 0 1 0 12 3.5 Z M10 14 L16 8 M11.5 8 H16 V12.5" />
                </Button>
                <!-- 3 commands — water.waves / terminal energy (Mac bar) -->
                <Button Classes="icon" ToolTip.Tip="Commands" Command="{Binding OpenCommandsSheetCommand}">
                  <Path Classes="icon-glyph"
                        Data="M3.5 8 C5.5 5.5, 8.5 5.5, 10.5 8 S15.5 10.5, 17.5 8 M3.5 12.5 C5.5 10, 8.5 10, 10.5 12.5 S15.5 15, 17.5 12.5 M3.5 17 C5.5 14.5, 8.5 14.5, 10.5 17 S15.5 19.5, 17.5 17" />
                </Button>
                <!-- 4 folder — Show in Explorer -->
                <Button Classes="icon" ToolTip.Tip="Open folder" Command="{Binding OpenSiteFolderCommand}">
                  <Path Classes="icon-glyph"
                        Data="M3.5 7.5 A1.5 1.5 0 0 1 5 6 h4.2 l1.8 2 H19 a1.5 1.5 0 0 1 1.5 1.5 v8 A1.5 1.5 0 0 1 19 19 H5 A1.5 1.5 0 0 1 3.5 17.5 Z" />
                </Button>
                <!-- 5 create user — Mac bar uses connected-nodes / share silhouette -->
                <Button Classes="icon" ToolTip.Tip="Create user" Command="{Binding OpenCreateUserSheetCommand}">
                  <Path Classes="icon-glyph"
                        Data="M6.5 9.5 A2.2 2.2 0 1 0 6.5 5.1 A2.2 2.2 0 1 0 6.5 9.5 Z M17.5 9.5 A2.2 2.2 0 1 0 17.5 5.1 A2.2 2.2 0 1 0 17.5 9.5 Z M12 18.5 A2.2 2.2 0 1 0 12 14.1 A2.2 2.2 0 1 0 12 18.5 Z M8.2 8.2 L10.3 14.8 M15.8 8.2 L13.7 14.8" />
                </Button>
                <!-- 6 site tools — slider.horizontal.3 / vertical sliders -->
                <Button Classes="icon" ToolTip.Tip="Site tools (Herd link / HTTPS)" Command="{Binding OpenSiteToolsCommand}">
                  <Path Classes="icon-glyph"
                        Data="M8 4.5 v15 M16 4.5 v15 M5.5 9.5 h5 M13.5 14.5 h5" />
                </Button>
                <!-- 7 copy path — Mac bar: rounded square with arrow.up.right -->
                <Button Classes="icon" ToolTip.Tip="Copy path" Command="{Binding CopySitePathCommand}">
                  <Path Classes="icon-glyph"
                        Data="M8 5.5 H6.5 A2 2 0 0 0 4.5 7.5 v10 A2 2 0 0 0 6.5 19.5 h10 a2 2 0 0 0 2 -2 V16 M13 4.5 h6.5 V11 M19.5 4.5 L11 13" />
                </Button>
              </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button Classes="ghost" Content="Copy errors" Command="{Binding CopyErrorsCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <Panel Grid.Row="1">
          <!-- SITES -->
          <Grid IsVisible="{Binding IsSitesNav}">
            <!-- Empty state -->
            <StackPanel IsVisible="{Binding SelectedSite, Converter={x:Static ObjectConverters.IsNull}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="420">
              <TextBlock Text="＋" FontSize="36" Foreground="#48484A" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding EmptyBody}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Classes="primary" Content="New Site" Command="{Binding OpenNewSiteWizardCommand}" />
                <Button Content="Import Existing" Command="{Binding OpenImportSheetCommand}" />
                <Button Content="Scan folder" Command="{Binding ScanSitesFolderCommand}" />
              </StackPanel>
            </StackPanel>

            <!-- Site detail: full width, Mac layout -->
            <DockPanel IsVisible="{Binding SelectedSite, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0">
              <!-- Centered pill tabs -->
              <Border DockPanel.Dock="Top" Padding="16,12,16,4">
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                  <Button Content="Overview" Command="{Binding SetDetailTabCommand}" CommandParameter="0"
                          Classes="pill" IsVisible="{Binding !IsDetailOverview}" />
                  <Button Content="Overview" Classes="pill-on" IsVisible="{Binding IsDetailOverview}" IsHitTestVisible="False" />
                  <Button Content="Packages" Command="{Binding SetDetailTabCommand}" CommandParameter="1"
                          Classes="pill" IsVisible="{Binding !IsDetailPackages}" />
                  <Button Content="Packages" Classes="pill-on" IsVisible="{Binding IsDetailPackages}" IsHitTestVisible="False" />
                  <Button Content="Git" Command="{Binding SetDetailTabCommand}" CommandParameter="2"
                          Classes="pill" IsVisible="{Binding !IsDetailGit}" />
                  <Button Content="Git" Classes="pill-on" IsVisible="{Binding IsDetailGit}" IsHitTestVisible="False" />
                  <Button Content="Deploy" Command="{Binding SetDetailTabCommand}" CommandParameter="3"
                          Classes="pill" IsVisible="{Binding !IsDetailDeploy}" />
                  <Button Content="Deploy" Classes="pill-on" IsVisible="{Binding IsDetailDeploy}" IsHitTestVisible="False" />
                  <Button Content="Activity" Command="{Binding SetDetailTabCommand}" CommandParameter="4"
                          Classes="pill" IsVisible="{Binding !IsDetailActivity}" />
                  <Button Content="Activity" Classes="pill-on" IsVisible="{Binding IsDetailActivity}" IsHitTestVisible="False" />
                </StackPanel>
              </Border>

              <!-- Single fill host so every tab gets height + scroll -->
              <Panel>
              <!-- OVERVIEW
                   WebView2 is a native HWND host — it goes blank inside ScrollViewer /
                   ClipToBounds. Keep the browser in a non-scrolling docked region. -->
              <DockPanel IsVisible="{Binding IsDetailOverview}" Margin="28,8,28,0">
                <!-- Live browser preview (WebView2) — fixed height, not in a scroller -->
                <Border DockPanel.Dock="Top" Classes="card" Padding="14" Margin="0,0,0,16"
                        MaxWidth="880" HorizontalAlignment="Center" Width="880">
                  <StackPanel Spacing="10">
                    <!-- ClipToBounds MUST stay false on the HWND host ancestor -->
                    <Border Classes="preview-frame" MinHeight="320" Height="380" ClipToBounds="False">
                      <Panel Background="#FFFFFF">
                        <wv:WebView x:Name="SitePreviewWebView"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="White" />
                        <!-- Fallback / status overlay when no URL yet or engine error text -->
                        <Border IsVisible="{Binding SitePreviewIsError}"
                                Background="#FFF8F8"
                                IsHitTestVisible="False">
                          <TextBlock Text="{Binding SitePreviewBody}"
                                     FontFamily="Cascadia Mono, Consolas, monospace"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     Foreground="#1C1C1E"
                                     Margin="16"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center" />
                        </Border>
                        <Border IsVisible="{Binding PreviewUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                Background="#FFFFFF"
                                IsHitTestVisible="False">
                          <TextBlock Text="{Binding SitePreviewBody}"
                                     FontFamily="Cascadia Mono, Consolas, monospace"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     Foreground="#1C1C1E"
                                     Margin="16"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     TextAlignment="Center" />
                        </Border>
                      </Panel>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding SitePreviewUrlLine}" Classes="muted" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding SitePreviewBadge}" Classes="dim" VerticalAlignment="Center" />
                        <Button Classes="ghost" Content="Refresh preview"
                                Command="{Binding RefreshPreviewCommand}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Everything under the preview can scroll freely -->
                <ScrollViewer Padding="0,0,0,48" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Spacing="16" MaxWidth="880" HorizontalAlignment="Center">
                    <!-- Installing -->
                    <Border IsVisible="{Binding IsInstallingSite}" Classes="card">
                      <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="Installing" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Grid.Column="1" Classes="muted" Text="{Binding InstallPhaseLabel}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Text="Status" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
                          <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding InstallProgress}"
                                       IsIndeterminate="{Binding InstallProgressIndeterminate}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding InstallStatus}" Classes="muted" TextWrapping="Wrap" />
                        <Button Classes="ghost" Content="Show / hide details" HorizontalAlignment="Left"
                                Command="{Binding ToggleInstallDetailsCommand}" />
                        <TextBox IsVisible="{Binding ShowInstallDetails}" Classes="log" Text="{Binding LogText}" MinHeight="140" />
                      </StackPanel>
                    </Border>

                    <!-- Statamic Utilities only (actions live in the top icon bar) -->
                    <Border Classes="card">
                      <StackPanel Spacing="10">
                        <TextBlock Text="Statamic Utilities" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Clear Cache flushes Laravel caches. Clear Stache rebuilds Statamic's content index. Clear Glide Cache deletes generated image transforms." />
                        <WrapPanel>
                          <Button Margin="0,0,8,8" Content="Clear Cache" Command="{Binding ClearCacheCommand}" />
                          <Button Margin="0,0,8,8" Content="Clear Stache" Command="{Binding ClearStacheCommand}" />
                          <Button Margin="0,0,8,8" Content="Warm Stache" Command="{Binding WarmStacheCommand}" />
                          <Button Margin="0,0,8,8" Content="Clear Glide Cache" Command="{Binding ClearGlideCommand}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>

              <!-- PACKAGES -->
              <DockPanel IsVisible="{Binding IsDetailPackages}" Margin="28,8,28,0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                  <Button Margin="0,0,8,8" Classes="primary" Content="Composer require…" Command="{Binding OpenComposerSheetCommand}" />
                  <Button Margin="0,0,8,8" Content="Update Packages" Command="{Binding ComposerUpdateCommand}" />
                  <Button Margin="0,0,8,8" Content="Composer install" Command="{Binding ComposerInstallCommand}" />
                </WrapPanel>
                <ScrollViewer Padding="0,0,8,48">
                  <ItemsControl ItemsSource="{Binding Packages}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PackageRow">
                        <Border Classes="card" Margin="0,0,0,10">
                          <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                            <TextBlock Classes="muted" Text="{Binding Version}" />
                            <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>

              <!-- GIT -->
              <ScrollViewer IsVisible="{Binding IsDetailGit}" Padding="28,8,28,48">
                <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Center">
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Save changes commits checked files locally. Nothing goes to GitHub until you Push or Sync." />
                  <WrapPanel>
                    <Button Margin="0,0,8,8" Content="Refresh" Command="{Binding RefreshGitCommand}" />
                    <Button Margin="0,0,8,8" Content="Initialize Git" Command="{Binding GitInitCommand}" />
                    <Button Margin="0,0,8,8" Classes="primary" Content="Save changes" Command="{Binding SaveChangesCommand}" />
                    <Button Margin="0,0,8,8" Content="Pull" Command="{Binding PullCommand}" />
                    <Button Margin="0,0,8,8" Content="Push" Command="{Binding PushCommand}" />
                    <Button Margin="0,0,8,8" Classes="primary" Content="Sync" Command="{Binding SyncCommand}" />
                  </WrapPanel>
                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding GitBranchLine}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="Commit message" FontWeight="SemiBold" />
                      <TextBox Text="{Binding GitCommitMessage}" />
                      <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                        <StackPanel Margin="0,0,8,0">
                          <TextBlock Text="Git name" FontWeight="SemiBold" />
                          <TextBox Text="{Binding GitUserName}" Watermark="Required once" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Git email" FontWeight="SemiBold" />
                          <TextBox Text="{Binding GitUserEmail}" Watermark="Required once" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Changed files" FontWeight="SemiBold" />
                      <ItemsControl ItemsSource="{Binding GitFiles}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:GitFileItem">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,4">
                              <CheckBox IsChecked="{Binding Selected}" />
                              <TextBlock Grid.Column="1" Text="{Binding Status}" Width="36" Margin="8,0" FontFamily="Consolas" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Button Classes="primary" Content="Back up to GitHub" Command="{Binding BackupToGitHubCommand}" HorizontalAlignment="Left" />
                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Recent commits" FontWeight="SemiBold" />
                      <TextBox Classes="log" Text="{Binding GitLogText}" MinHeight="140" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <!-- DEPLOY -->
              <ScrollViewer IsVisible="{Binding IsDetailDeploy}" Padding="28,8,28,48">
                <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Center">
                  <Border Classes="card">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Deploy" FontWeight="SemiBold" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="Laravel Cloud for dynamic sites. Netlify or Cloudflare Pages for static SSG. Connect hosts first — tokens stay in the secret store." />
                      <Button Content="Check deploy prerequisites" Command="{Binding DeployPrerequisiteCheckCommand}" HorizontalAlignment="Left" />
                      <Button Content="Back up to GitHub first" Command="{Binding BackupToGitHubCommand}" HorizontalAlignment="Left" />
                      <Button Classes="primary" Content="Connect a New Host" Command="{Binding OpenConnectHostSheetCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Deployment history" FontWeight="SemiBold" />
                      <TextBlock Classes="muted" Text="No deploys yet." />
                      <ItemsControl ItemsSource="{Binding Deployments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:DeploymentRecord">
                            <TextBlock Margin="0,4" Text="{Binding Summary}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <!-- ACTIVITY (was side rail) -->
              <ScrollViewer IsVisible="{Binding IsDetailActivity}" Padding="28,8,28,48">
                <StackPanel Spacing="14" MaxWidth="880" HorizontalAlignment="Center">
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Live log output and conflict advice from the last command." />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Copy errors" Command="{Binding CopyErrorsCommand}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Advice}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:ConflictAdvice">
                        <Border Background="#2A1A20" CornerRadius="10" Padding="12" BorderBrush="#5B3A4A" BorderThickness="1" Margin="0,0,0,8">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="card" Padding="0">
                    <TextBox Classes="log" Text="{Binding LogText}" MinHeight="360" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
              </Panel>
            </DockPanel>
          </Grid>

          <!-- HOSTS -->
          <ScrollViewer IsVisible="{Binding IsHostsNav}" Padding="28,20,28,40">
            <StackPanel Spacing="16" MaxWidth="720">
              <TextBlock Text="Hosts" FontSize="22" FontWeight="SemiBold" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Tokens stay in the Windows secret store. Sherpa never writes them into your sites." />
              <Button Classes="primary" Content="Connect a New Host" Command="{Binding OpenConnectHostSheetCommand}" HorizontalAlignment="Left" />
              <ItemsControl ItemsSource="{Binding HostAccounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:HostAccount">
                    <Border Classes="card" Margin="0,0,0,8">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        <TextBlock Classes="muted" Text="{Binding Provider}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="card">
                <StackPanel Spacing="6">
                  <TextBlock Text="Dynamic hosting" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" Text="Laravel Forge · Laravel Cloud" />
                  <TextBlock Text="Static hosting" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Classes="muted" Text="Cloudflare Pages · Netlify" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- SETTINGS -->
          <ScrollViewer IsVisible="{Binding IsSettingsNav}" Padding="28,20,28,48">
            <StackPanel Spacing="16" MaxWidth="720">
              <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Default sites folder" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding DefaultSitesFolder}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseSitesFolderCommand}" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Scan for sites" Command="{Binding ScanSitesFolderCommand}" />
                  </StackPanel>
                  <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                             Text="Scan looks one level deep for folders that contain composer.json (Statamic/Laravel) and adds any missing ones to the sidebar." />
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <TextBlock Text="Prefer Herd for new sites" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding PreferHerdForNewSites}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Secure new Herd sites with HTTPS" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding SecureNewHerdSites}" />
                  </Grid>
                  <TextBlock Text="Git name" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBox Text="{Binding GitUserName}" />
                  <TextBlock Text="Git email" FontWeight="SemiBold" />
                  <TextBox Text="{Binding GitUserEmail}" />
                  <TextBlock Text="PHP path (optional)" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBox Text="{Binding PreferredPhp}" Watermark="Auto-detect Herd / PATH" />
                  <TextBlock Text="Composer path (optional)" FontWeight="SemiBold" />
                  <TextBox Text="{Binding PreferredComposer}" />
                  <TextBlock Text="Git path (optional)" FontWeight="SemiBold" />
                  <TextBox Text="{Binding PreferredGit}" />
                  <Button Classes="primary" Content="Save settings" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="Updates" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding UpdateVersionLine}" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding UpdateStatus}" Classes="muted" TextWrapping="Wrap" />
                  <ProgressBar Minimum="0" Maximum="100"
                               Value="{Binding UpdateDownloadProgress}"
                               IsIndeterminate="{Binding UpdateDownloadIndeterminate}"
                               Height="6" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Check for updates"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding !UpdateIsBusy}" />
                    <Button Content="Download update"
                            Command="{Binding DownloadUpdateCommand}"
                            IsEnabled="{Binding UpdateCanDownload}" />
                    <Button Content="Restart &amp; install"
                            Command="{Binding ApplyUpdateAndRestartCommand}"
                            IsEnabled="{Binding UpdateCanApply}" />
                  </StackPanel>
                  <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                             Text="Updates come from GitHub Releases (welbinator/sherpa-windows). Install Sherpa with Setup.exe once — after that, this button keeps you current." />

                  <TextBlock Text="Go back to a previous version" FontWeight="SemiBold" Margin="0,10,0,0" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                             Text="Shows up to 5 earlier releases before the one you’re on. Pick one, download it, then Restart &amp; install. (Only versions that shipped with the Setup installer.)" />
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding PreviousReleases}"
                              SelectedItem="{Binding SelectedRollbackRelease}"
                              MinHeight="36"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Previous versions…" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="Refresh list"
                            Command="{Binding RefreshPreviousReleasesCommand}"
                            IsEnabled="{Binding !UpdateIsBusy}" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                      <Button Classes="primary" Content="Download this version"
                              Command="{Binding DownloadRollbackCommand}"
                              IsEnabled="{Binding !UpdateIsBusy}" />
                      <Button Content="Restart &amp; install"
                              Command="{Binding ApplyUpdateAndRestartCommand}"
                              IsEnabled="{Binding RollbackCanApply}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding RollbackStatus}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Text="GitHub personal access token" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Create a classic token at GitHub → Settings → Developer settings. Used for private starter kits, package repos, and Back up to GitHub." />
                  <TextBox Watermark="ghp_…" PasswordChar="•" Text="{Binding GitHubTokenInput}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Save GitHub token" Command="{Binding SaveGitHubTokenCommand}" />
                    <Button Content="Remove" Command="{Binding ClearGitHubTokenCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding GitHubStatus}" Classes="muted" TextWrapping="Wrap" />
                  <TextBlock Text="Packagist / Composer auth token" FontWeight="SemiBold" Margin="0,12,0,0" />
                  <TextBox Watermark="optional" PasswordChar="•" Text="{Binding PackagistTokenInput}" />
                  <Button Classes="primary" Content="Save Packagist token" Command="{Binding SavePackagistTokenCommand}" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding PackagistStatus}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="Detected runtimes" FontWeight="SemiBold" />
                  <TextBox Classes="log" Text="{Binding RuntimeStatus}" MinHeight="120" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource BgSidebarBrush}" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" FontSize="12"
                   Text="{Binding StatusLine}" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding !IsInstallingSite}" />
        <TextBlock Grid.Column="1" Classes="dim" FontSize="11"
                   Text="Sherpa · Tokens stay in the Windows secret store" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Toast -->
    <Border IsVisible="{Binding ShowToast}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,20,48" Classes="card" ZIndex="20" MaxWidth="320">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding ToastTitle}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding ToastBody}" Classes="muted" TextWrapping="Wrap" />
        <Button Classes="ghost" Content="Dismiss" Command="{Binding DismissToastCommand}" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>

    <!-- NEW SITE WIZARD — large modal; body is a single fill Grid so every step scrolls -->
    <Grid IsVisible="{Binding ShowNewSiteWizard}" Background="#CC000000" ZIndex="30">
      <Border Classes="modal"
              Width="{Binding WizardModalWidth}"
              Height="{Binding WizardModalHeight}"
              MinWidth="640" MinHeight="520"
              MaxWidth="1100" MaxHeight="860"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="0">
        <DockPanel>
          <!-- Header -->
          <Border DockPanel.Dock="Top" Padding="22,18,22,12" BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="{Binding WizardTitle}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Classes="muted" FontSize="13" Margin="0,4,0,0" Text="{Binding WizardSubtitle}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Classes="ghost" Content="✕" Command="{Binding CloseNewSiteWizardCommand}" VerticalAlignment="Top" Padding="10,6" />
            </Grid>
          </Border>

          <!-- Footer actions — always visible, never covers scroll body -->
          <Border DockPanel.Dock="Bottom" Padding="22,14" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <Button Classes="ghost" Content="Cancel" Command="{Binding CloseNewSiteWizardCommand}" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Back" Command="{Binding WizardBackCommand}" IsVisible="{Binding WizardCanGoBack}" />
                <Button Classes="primary" Content="Continue" Command="{Binding WizardNextCommand}" IsVisible="{Binding WizardCanGoNext}" />
                <Button Classes="primary" Content="Create Site" Command="{Binding CreateSiteCommand}" IsVisible="{Binding WizardIsOptions}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Body: ONE child fills remaining height; steps overlay with IsVisible -->
          <Panel Margin="0">
            <!-- STEP 0 identity -->
            <ScrollViewer IsVisible="{Binding WizardIsIdentity}" Padding="28,18,28,24">
              <StackPanel Spacing="0" MaxWidth="720" HorizontalAlignment="Stretch">
                <Border Classes="form-row">
                  <Grid ColumnDefinitions="160,*">
                    <TextBlock Text="Site name" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="1" Text="{Binding NewSiteName}" Watermark="my-site" />
                  </Grid>
                </Border>
                <Border Classes="form-row">
                  <Grid ColumnDefinitions="160,*,Auto">
                    <TextBlock Text="Folder" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="1" Text="{Binding NewSiteFolder}" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Choose…" Command="{Binding BrowseNewSiteFolderCommand}" />
                  </Grid>
                </Border>
                <Border Classes="form-row">
                  <Grid ColumnDefinitions="160,*">
                    <TextBlock Text="URL preview" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="1" Text="{Binding NewSiteUrlPreview}" IsReadOnly="True" />
                  </Grid>
                </Border>
                <Border Classes="form-row">
                  <Grid ColumnDefinitions="160,*">
                    <TextBlock Text="Will create" VerticalAlignment="Center" Classes="muted" />
                    <TextBox Grid.Column="1" Text="{Binding NewSiteWillCreate}" IsReadOnly="True" />
                  </Grid>
                </Border>
                <Border Classes="form-row">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Park in Herd and open as site.test" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding NewSiteParkInHerd}" />
                  </Grid>
                </Border>
                <Border Classes="form-row" BorderThickness="0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Secure with HTTPS (Herd)" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding NewSiteSecureHttps}" />
                  </Grid>
                </Border>
                <Border Background="#1C1C1E" CornerRadius="10" Padding="14" Margin="0,16,0,0" BorderBrush="#3A3A3C" BorderThickness="1">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding RuntimePhpLine}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding RuntimePhpDetail}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- STEP 1 kits — 3-column grid, larger canvas -->
            <DockPanel IsVisible="{Binding WizardIsKits}" Margin="20,12,20,8">
              <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Watermark="Search starter kits" Text="{Binding KitSearch}" />
                  <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Classes="muted"
                             Text="{Binding KitsStatus}" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="All" Command="{Binding SelectKitFilterCommand}" CommandParameter="0"
                          Classes="chip" IsVisible="{Binding !KitFilterIsAll}" />
                  <Button Content="All" Classes="chip-on" IsVisible="{Binding KitFilterIsAll}" IsHitTestVisible="False" />
                  <Button Content="Free" Command="{Binding SelectKitFilterCommand}" CommandParameter="1"
                          Classes="chip" IsVisible="{Binding !KitFilterIsFree}" />
                  <Button Content="Free" Classes="chip-on" IsVisible="{Binding KitFilterIsFree}" IsHitTestVisible="False" />
                  <Button Content="Paid" Command="{Binding SelectKitFilterCommand}" CommandParameter="2"
                          Classes="chip" IsVisible="{Binding !KitFilterIsPaid}" />
                  <Button Content="Paid" Classes="chip-on" IsVisible="{Binding KitFilterIsPaid}" IsHitTestVisible="False" />
                </StackPanel>
                <TextBlock IsVisible="{Binding KitsLoading}" Text="Loading Marketplace…" Classes="muted" />
              </StackPanel>

              <ListBox Classes="kit-grid"
                       ItemsSource="{Binding FilteredKits}"
                       SelectedItem="{Binding SelectedKit}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StarterKitRow">
                    <Border Classes="kit-card">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="14" />
                          <Border Grid.Column="1" Background="#3A3A3C" CornerRadius="6" Padding="6,2" Margin="6,0,0,0">
                            <TextBlock Text="{Binding PriceLabel}" FontSize="11" Classes="muted" />
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding SellerName}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12"
                                   TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Package}" FontSize="11" Classes="dim" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <!-- STEP 2 storage -->
            <ScrollViewer IsVisible="{Binding WizardIsStorage}" Padding="28,18,28,24">
              <StackPanel Spacing="14" MaxWidth="640">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Where do you want to store your content and data? When in doubt, choose Flat Files. You can always change this later." />
                <RadioButton Content="Flat Files (typical)" GroupName="Storage" IsChecked="{Binding StorageFlatFiles}" />
                <RadioButton Content="Database — SQLite" GroupName="Storage" IsChecked="{Binding StorageSqlite}" />
                <RadioButton Content="Database — MySQL" GroupName="Storage" IsChecked="{Binding StorageMySql}" />
                <StackPanel IsVisible="{Binding ShowMySqlFields}" Spacing="8" Margin="0,8,0,0">
                  <TextBlock Text="MySQL connection" FontWeight="SemiBold" />
                  <TextBox Watermark="Host" Text="{Binding MySqlHost}" />
                  <TextBox Watermark="Database" Text="{Binding MySqlDatabase}" />
                  <TextBox Watermark="User" Text="{Binding MySqlUser}" />
                  <TextBox Watermark="Password" PasswordChar="•" Text="{Binding MySqlPassword}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <!-- STEP 3 options -->
            <ScrollViewer IsVisible="{Binding WizardIsOptions}" Padding="28,18,28,24">
              <StackPanel Spacing="14" MaxWidth="640">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Last step before install. Create Site runs Composer and the rest of the setup." />

                <StackPanel Spacing="4">
                  <CheckBox Content="Enable Statamic Pro" IsChecked="{Binding EnableStatamicPro}" IsEnabled="False" />
                  <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="28,0,0,0"
                             Text="Before your site goes live you will need a license on statamic.com. (Toggle locked off for now.)" />
                </StackPanel>

                <CheckBox Content="Generate a static site (installs the Static Site Generator add-on)" IsChecked="{Binding InstallSsg}" />
                <CheckBox Content="Initialize Git" IsChecked="{Binding InitGit}" />
                <CheckBox Content="Create a super user" IsChecked="{Binding CreateSuperUserOnCreate}" />

                <StackPanel IsVisible="{Binding CreateSuperUserOnCreate}" Spacing="8" Margin="8,0,0,8">
                  <TextBlock Text="Name" FontWeight="SemiBold" />
                  <TextBox Text="{Binding SuperUserName}" />
                  <TextBlock Text="Email" FontWeight="SemiBold" />
                  <TextBox Text="{Binding SuperUserEmail}" />
                  <TextBlock Text="Password" FontWeight="SemiBold" />
                  <TextBox PasswordChar="•" Text="{Binding SuperUserPassword}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Import -->
    <Grid IsVisible="{Binding ShowImportSheet}" Background="#CC000000" ZIndex="30">
      <Border Classes="modal" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="Import Existing Site" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="Point Sherpa at a folder that already has Statamic installed." />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding ImportPath}" />
            <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseImportFolderCommand}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CloseImportSheetCommand}" />
            <Button Classes="primary" Content="Import" Command="{Binding ImportSiteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Composer require -->
    <Grid IsVisible="{Binding ShowComposerSheet}" Background="#CC000000" ZIndex="30">
      <Border Classes="modal" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="Composer require" FontSize="20" FontWeight="SemiBold" />
          <TextBox Watermark="vendor/package" Text="{Binding RequirePackage}" />
          <TextBox Watermark="version (optional)" Text="{Binding RequireVersion}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CloseComposerSheetCommand}" />
            <Button Classes="primary" Content="Require" Command="{Binding ComposerRequireCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Create user -->
    <Grid IsVisible="{Binding ShowCreateUserSheet}" Background="#CC000000" ZIndex="30">
      <Border Classes="modal" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="Create User" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="Creates a user via please make:user." />
          <TextBox Watermark="email" Text="{Binding CreateUserEmail}" />
          <TextBox Watermark="password" PasswordChar="•" Text="{Binding CreateUserPassword}" />
          <CheckBox Content="Create a super user" IsChecked="{Binding CreateUserSuper}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CloseCreateUserSheetCommand}" />
            <Button Classes="primary" Content="Create" Command="{Binding CreateUserCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Commands -->
    <Grid IsVisible="{Binding ShowCommandsSheet}" Background="#CC000000" ZIndex="30">
      <Border Classes="modal" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="Commands" FontSize="20" FontWeight="SemiBold" />
          <TextBox Watermark="please stache:clear   or   artisan migrate" Text="{Binding CustomCommand}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CloseCommandsSheetCommand}" />
            <Button Classes="primary" Content="Run" Command="{Binding RunCustomCommandCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Connect host -->
    <Grid IsVisible="{Binding ShowConnectHostSheet}" Background="#CC000000" ZIndex="30">
      <Border Classes="modal" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="12">
          <TextBlock Text="Connect a New Host" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="Pick a provider, paste the API token. Token stays in the secret store." TextWrapping="Wrap" />
          <ComboBox SelectedIndex="{Binding ConnectHostKind}">
            <ComboBoxItem Content="(choose)" />
            <ComboBoxItem Content="Laravel Forge" />
            <ComboBoxItem Content="Laravel Cloud" />
            <ComboBoxItem Content="Cloudflare Pages" />
            <ComboBoxItem Content="Netlify" />
          </ComboBox>
          <TextBox Watermark="Label (optional)" Text="{Binding HostLabelInput}" />
          <TextBox Watermark="API token" PasswordChar="•" Text="{Binding HostTokenInput}" />
          <TextBox Watermark="Cloudflare Account ID (if Pages)" Text="{Binding HostExtraInput}" />
          <TextBlock Text="{Binding ConnectHostStatus}" Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CloseConnectHostSheetCommand}" />
            <Button Classes="primary" Content="Connect" Command="{Binding ConnectHostCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Site tools (Herd link / HTTPS) — gear icon -->
    <Grid IsVisible="{Binding ShowSiteToolsSheet}" Background="#CC000000" ZIndex="30">
      <Border Classes="modal" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="Site tools" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="These used to live as big buttons on Overview. They’re here now so Overview stays clean like Mac Sherpa." />
          <Button Content="Link / park in Herd" Command="{Binding LinkHerdCommand}" HorizontalAlignment="Stretch" />
          <Button Classes="primary" Content="Secure with HTTPS (Herd)" Command="{Binding SecureHerdCommand}" HorizontalAlignment="Stretch" />
          <Button Content="Open folder" Command="{Binding OpenSiteFolderCommand}" HorizontalAlignment="Stretch" />
          <Button Content="Open in browser" Command="{Binding OpenSiteUrlCommand}" HorizontalAlignment="Stretch" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Classes="ghost" Content="Close" Command="{Binding CloseSiteToolsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Delete confirm -->
    <Grid IsVisible="{Binding ShowDeleteConfirm}" Background="#CC000000" ZIndex="30">
      <Border Classes="modal" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="Delete Site" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Remove keeps the folder on disk. Delete site files removes the project folder from disk." />
          <CheckBox Content="Delete site files too" IsChecked="{Binding DeleteSiteFilesToo}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CancelDeleteCommand}" />
            <Button Classes="danger" Content="Remove" Command="{Binding PerformDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
